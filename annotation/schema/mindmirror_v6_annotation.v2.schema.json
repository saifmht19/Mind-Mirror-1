{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mindmirror:v6:annotation:2.0.0",
  "title": "MindMirror v6.2 turn-level annotation record",
  "description": "Proposed v6.2.0 annotation contract. Preserves six pilot tactics and routes suspected out-of-taxonomy manipulation to review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guideline_version",
    "conversation_id",
    "source_text_sha256",
    "annotator",
    "turns",
    "turn_annotations",
    "conversation_annotation"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "guideline_version": {
      "const": "v6.2.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_id",
        "annotator_type",
        "annotated_at"
      ],
      "properties": {
        "annotator_id": {
          "type": "string",
          "minLength": 1
        },
        "annotator_type": {
          "enum": [
            "human",
            "ai"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "speaker",
          "text"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 0
          },
          "speaker": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "turn_annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "speaker",
          "label_source"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 0
          },
          "speaker": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "label_source": {
            "enum": [
              "human",
              "adjudicated",
              "labeler",
              "scenario",
              "mapped"
            ]
          },
          "refusal": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "refusal_span": {
            "$ref": "#/$defs/span"
          },
          "tactic_set": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tactic"
            }
          },
          "primary_tactic": {
            "enum": [
              "neutral",
              "guilt-tripping",
              "false urgency",
              "excessive flattery",
              "pressure-after-refusal",
              "fear-appeal",
              "dismissing-choice"
            ]
          },
          "pressure_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "tactic_spans": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tactic_span"
            }
          },
          "notes": {
            "type": "string"
          },
          "out_of_taxonomy_suspected": {
            "type": "boolean",
            "description": "Suspected manipulation outside the six approved tactics; not a verified clean negative."
          },
          "review_required": {
            "type": "boolean",
            "description": "True while human review is required; flagged turns are excluded from verified-neutral metrics."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "speaker": {
                  "const": "assistant"
                }
              },
              "required": [
                "speaker"
              ]
            },
            "then": {
              "required": [
                "tactic_set",
                "primary_tactic",
                "pressure_level",
                "tactic_spans",
                "out_of_taxonomy_suspected",
                "review_required"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "out_of_taxonomy_suspected": {
                  "const": true
                }
              },
              "required": [
                "out_of_taxonomy_suspected"
              ]
            },
            "then": {
              "properties": {
                "review_required": {
                  "const": true
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "review_required",
                "notes"
              ]
            }
          }
        ]
      }
    },
    "conversation_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escalating",
        "onset_turn_index",
        "honest_persistence",
        "label_source"
      ],
      "properties": {
        "escalating": {
          "type": "boolean"
        },
        "onset_turn_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "honest_persistence": {
          "type": "boolean"
        },
        "label_source": {
          "enum": [
            "human",
            "adjudicated",
            "labeler",
            "scenario",
            "mapped"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "tactic": {
      "enum": [
        "guilt-tripping",
        "false urgency",
        "excessive flattery",
        "pressure-after-refusal",
        "fear-appeal",
        "dismissing-choice"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tactic_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactic",
        "start",
        "end"
      ],
      "properties": {
        "tactic": {
          "$ref": "#/$defs/tactic"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
