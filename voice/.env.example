# APPEND these lines to the repo-root .env.example (do not replace it).
# Copy to .env at the repo root. Everything defaults to STUB so the project runs with no models.
VOICE_DATA_DIR=.voice_runtime

# stub | real  (flip one at a time during integration)
VOICE_IMPL_INPUT=stub
VOICE_IMPL_OUTPUT=stub
VOICE_IMPL_FEATURES=stub
VOICE_IMPL_DETECTOR=stub
VOICE_IMPL_GENERATOR=stub

# text | context | context_voice
MINDMIRROR_DETECTOR=context_voice
MINDMIRROR_FLAG_THRESHOLD=0.5

# Module 1
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Module 2
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a

# Existing text+context system (Integrator: add whatever adapters.py needs)
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=

# Privacy defaults (the project states no conversation history is stored on the server)
VOICE_PERSIST=0              # 1 = also write turns to JSONL under VOICE_DATA_DIR
VOICE_KEEP_USER_AUDIO=0      # 1 = keep the user's WAV after analysis
VOICE_AUDIO_TTL_S=900        # delete TTS audio / idle sessions after this many seconds
VOICE_DETECT_WAIT_MS=1500    # a turn waits this long for the detector, then returns detection="pending"
